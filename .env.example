# =========================================================
# VARIÁVEIS DE AMBIENTE — SISTEMA DE CONTROLE DE RECIBOS
# =========================================================

# Diretório customizado para armazenamento da base de dados local (opcional)
# Se não for definido, o sistema utilizará o diretório padrão ./dados/recibos
DIR_DADOS_RECIBOS=

# Chave secreta da aplicação (opcional)
SECRET_KEY=

# Configurações opcionais para integração futura com nuvem (não necessário no modo offline)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SPREADSHEET_ID=

